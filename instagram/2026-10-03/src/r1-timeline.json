[{"i": 1, "start": 0.27, "end": 3.068, "text": "Você provavelmente não precisa de mais tráfego.", "sec": 0.3, "src": [0.0, 2.76807], "words": [{"w": "Você", "t": 0.33}, {"w": "provavelmente", "t": 0.675}, {"w": "não", "t": 1.57}, {"w": "precisa", "t": 1.815}, {"w": "de", "t": 2.165}, {"w": "mais", "t": 2.445}, {"w": "tráfego.", "t": 2.58}]}, {"i": 2, "start": 3.354, "end": 6.243, "text": "Precisa descobrir onde seus leads estão morrendo.", "sec": 0.3, "src": [3.0841, 5.94331], "words": [{"w": "Precisa", "t": 3.379}, {"w": "descobrir", "t": 4.004}, {"w": "onde", "t": 4.429}, {"w": "seus", "t": 4.879}, {"w": "leads", "t": 4.989}, {"w": "estão", "t": 5.094}, {"w": "morrendo.", "t": 5.664}]}, {"i": 3, "start": 6.713, "end": 8.02, "text": "O anúncio funciona.", "sec": 6.0, "src": [6.20431, 7.48141], "words": [{"w": "O", "t": 6.738}, {"w": "anúncio", "t": 7.028}, {"w": "funciona.", "t": 7.393}]}, {"i": 4, "start": 8.279, "end": 9.327, "text": "O lead chama.", "sec": 6.0, "src": [7.77048, 8.7881], "words": [{"w": "O", "t": 8.324}, {"w": "lead", "t": 8.459}, {"w": "chama.", "t": 8.934}]}, {"i": 5, "start": 9.622, "end": 11.271, "text": "E aí começa o problema.", "sec": 6.0, "src": [9.11317, 10.7322], "words": [{"w": "E", "t": 9.682}, {"w": "aí", "t": 9.897}, {"w": "começa", "t": 10.112}, {"w": "o", "t": 10.522}, {"w": "problema.", "t": 10.582}]}, {"i": 6, "start": 11.741, "end": 13.324, "text": "Ninguém responde à noite.", "sec": 11.0, "src": [11.0224, 12.5751], "words": [{"w": "Ninguém", "t": 11.771}, {"w": "responde", "t": 12.231}, {"w": "à", "t": 12.706}, {"w": "noite.", "t": 12.956}]}, {"i": 7, "start": 13.639, "end": 15.358, "text": "A resposta vem genérica.", "sec": 11.0, "src": [12.9208, 14.6098], "words": [{"w": "A", "t": 13.639}, {"w": "resposta", "t": 13.769}, {"w": "vem", "t": 14.399}, {"w": "genérica.", "t": 14.669}]}, {"i": 8, "start": 15.683, "end": 18.2, "text": "O follow-up depende da memória de alguém.", "sec": 11.0, "src": [14.9642, 17.4518], "words": [{"w